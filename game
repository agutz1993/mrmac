<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MacMan - Mr. McClain Edition</title>
    <link rel="stylesheet" href="style.css">
    <style>
        body {
            background-color: black;
            text-align: center;
            color: #0ff;
            font-family: 'Press Start 2P', cursive;
        }
        #game-title {
            font-size: 32px;
            text-shadow: 0 0 10px #0ff, 0 0 20px #0ff;
        }
        #instructions {
            font-size: 16px;
            text-shadow: 0 0 5px #fff;
        }
        canvas {
            background-color: #222;
            display: block;
            margin: 0 auto;
            border: 3px solid #0ff;
            box-shadow: 0 0 20px #0ff;
        }
    </style>
</head>
<body>
    <h1 id="game-title">MacMan - Mr. McClain Edition</h1>
    <canvas id="gameCanvas"></canvas>
    <p id="instructions">Use arrow keys to move MacMan and eat the Solana tokens!</p>
    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");
        canvas.width = 400;
        canvas.height = 400;

        const macMan = new Image();
        macMan.src = "black-curly-dog.png";
        const solToken = new Image();
        solToken.src = "solana-token.png";

        let macManX = 180, macManY = 180, dx = 0, dy = 0;
        let tokens = [{x: 100, y: 100}, {x: 300, y: 200}, {x: 200, y: 300}];

        document.addEventListener("keydown", (event) => {
            if (event.key === "ArrowUp") { dx = 0; dy = -20; }
            if (event.key === "ArrowDown") { dx = 0; dy = 20; }
            if (event.key === "ArrowLeft") { dx = -20; dy = 0; }
            if (event.key === "ArrowRight") { dx = 20; dy = 0; }
        });

        function update() {
            macManX += dx;
            macManY += dy;
            if (macManX < 0) macManX = 380;
            if (macManX > 380) macManX = 0;
            if (macManY < 0) macManY = 380;
            if (macManY > 380) macManY = 0;
            tokens = tokens.filter(token => !(macManX === token.x && macManY === token.y));
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(macMan, macManX, macManY, 40, 40);
            tokens.forEach(token => ctx.drawImage(solToken, token.x, token.y, 20, 20));
        }

        function gameLoop() {
            update();
            draw();
            requestAnimationFrame(gameLoop);
        }

        macMan.onload = function() {
            solToken.onload = function() {
                gameLoop();
            };
        };
    </script>
</body>
</html>
